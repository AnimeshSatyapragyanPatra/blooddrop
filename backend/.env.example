# Copy to backend/.env for local dev.
# Leave MOCK_DB=1 to run with no Supabase at all.

MOCK_DB=1
# 5060 and 5061 are on Chrome's blocked-port list (SIP), so avoid them here.
PORT=5065

# Domain rules
DONATION_GAP_DAYS=90     # minimum days between whole-blood donations
DISPATCH_BATCH=25        # max donors alerted per dispatch round

# Real Supabase (remove MOCK_DB above once these are set):
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=your_anon_public_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Optional alert providers. Without these, email/SMS alerts are logged to the
# server console and the in-app inbox is used for real delivery.
# RESEND_API_KEY=
# SMS_API_KEY=

# Frontend env lives in frontend/.env.local — see frontend/.env.example

# Set NOTIFY_TRACE=1 to print each simulated email/SMS alert to the server log.
# Off by default: a single dispatch reaches up to 25 donors and would otherwise
# fill the log with lines for messages that were never actually sent.
# NOTIFY_TRACE=1
